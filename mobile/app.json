{
  "expo": {
    "name": "Vendalia",
    "slug": "vendalia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vendalia",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netcore.vendalia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#a855f7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.netcore.vendalia",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2169ea0d-b0a1-4177-b163-bb5e9b8b8335"
      }
    }
  }
}
